{
  "baseURL": "https://vovoring.github.io/BP_Assignment_01/",
  "defaultContentLanguage": "ko",
  "languageCode": "ko-kr",
  "hasCJKLanguage": true,
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "Hermit - V2",
  "params": {
    "themeColor": "#494f5c",
    "accentColor": "#018472",
    "homeSubtitle": "Minimalist, production-ready Hugo theme for modern bloggers & developers",
    "homeSubtitlePrinter": true,
    "footerCopyright": "vovoring",
    "code_copy_button": true,
    "scrollToTop": true,
    "shareSocial": true,
    "usesAnimation": true,
    "listLayout": [
      "description",
      "tags",
      "categories"
    ],
    "author": {
      "name": "vovoring"
    },
    "socialLinks": [
      {
        "name": "github",
        "url": "https://github.com/vovoring"
      },
      {
        "name": "email",
        "url": "mailto:your-email@example.com"
      }
    ]
  },
  "menu": {
    "main": [
      {
        "name": "Posts",
        "url": "posts/",
        "weight": 10
      },
      {
        "name": "About",
        "url": "about/",
        "weight": 20
      }
    ]
  }
}
